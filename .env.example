# Copy to .env and supply real values locally. Never commit .env.
# Containers need a reachable SQL Server; Windows LocalDB cannot be used from Linux.
WEATHER_SQL_CONNECTION=Server=host.docker.internal,1433;Database=weather;User ID=weather;Password=replace-me;Encrypt=true;TrustServerCertificate=true
AMBIENT_API_KEY=
AMBIENT_APPLICATION_KEY=
AMBIENT_DEVICE_MAC_ADDRESS=
WEATHER_API_PORT=5001
WEATHER_MCP_PORT=5000
# Optional image registry prefix includes a trailing slash, e.g. ghcr.io/your-org/
DOCKER_REGISTRY=
WEATHER_IMAGE_TAG=local
